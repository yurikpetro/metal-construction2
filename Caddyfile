{$DOMAIN} {
	reverse_proxy app:3000
}

# Склейка зеркал: www отдаёт постоянный редирект на основной адрес,
# чтобы поисковики не считали www и не-www разными сайтами.
# Требует A-записи для www в DNS — иначе Caddy не получит сертификат.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Второй домен кровельные-ограждения26.рф — только редирект на основной,
# контент он не отдаёт (иначе для поисковиков это дубль сайта).
# Адрес записан в punycode: Caddy и Let's Encrypt работают с ASCII-формой.
# Если A-записи для .рф ещё не прописаны, Caddy будет циклично пытаться
# получить сертификат и писать ошибки ACME в лог — на работу основного
# домена это не влияет, но до настройки DNS блок можно закомментировать.
xn---26-6cdihieaej0aqq4ahfg4aj0uua6f.xn--p1ai,
www.xn---26-6cdihieaej0aqq4ahfg4aj0uua6f.xn--p1ai {
	redir https://{$DOMAIN}{uri} permanent
}
