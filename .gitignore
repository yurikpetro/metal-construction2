# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — реальные .env с секретами не коммитим, но .env.example/.env.production.example оставляем
.env
.env.local
.env.*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# загруженные через админку фото — не часть исходного кода
/public/uploads

# локальная база SQLite и служебные файлы WAL-режима
/*.db
/*.db-journal
/*.db-wal
/*.db-shm
/backups

# IDE
.idea/
