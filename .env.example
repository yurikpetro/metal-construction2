# SQLite — файл базы данных лежит рядом со схемой, ничего дополнительно поднимать не нужно.
DATABASE_URL="file:./dev.db"

# Admin auth session — generate a random 32+ char string for production
SESSION_SECRET="dev-only-change-me-in-production-min-32-chars-long"

# Telegram bot notifications (get token from @BotFather, chat id by messaging the bot then GET api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email notifications (Resend — resend.com)
RESEND_API_KEY=""
# До подтверждения своего домена в Resend можно отправлять с onboarding@resend.dev
RESEND_FROM_EMAIL="onboarding@resend.dev"
ADMIN_NOTIFICATION_EMAIL=""

# Адрес сайта — из него строятся canonical, sitemap.xml, robots.txt и og:image
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Серверная копия того же адреса: читается в рантайме и страхует robots.txt
# и sitemap.xml от localhost (подробнее — в .env.production.example)
SITE_URL="http://localhost:3000"

# Яндекс.Метрика (необязательно) — ID счётчика с metrika.yandex.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# Коды подтверждения прав на сайт (необязательно локально)
GOOGLE_SITE_VERIFICATION=""
YANDEX_VERIFICATION=""

# Seed-скрипт создаёт этого админа при первом запуске (npx prisma db seed)
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="changeme123"
