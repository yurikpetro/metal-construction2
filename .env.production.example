# Копируйте этот файл в .env на сервере (рядом с docker-compose.yml) и заполните реальными значениями.
# Этот .env читает и docker-compose.yml (переменные POSTGRES_*/DOMAIN), и само приложение внутри контейнера.

# --- Postgres (используется контейнером postgres и в DATABASE_URL ниже) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=metal_construction

# Хост "postgres" — это имя сервиса в docker-compose.yml, а не localhost
DATABASE_URL=postgresql://app:change-me-strong-password@postgres:5432/metal_construction?schema=public

# --- Домен для Caddy (автоматический HTTPS через Let's Encrypt) ---
DOMAIN=example.com

# --- Сессии админки ---
SESSION_SECRET=generate-a-random-32-plus-char-secret

# --- Telegram-уведомления о новых заявках ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email-уведомления (Resend) ---
RESEND_API_KEY=
# Требует подтверждённого домена в Resend; до этого можно использовать onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=

NEXT_PUBLIC_SITE_URL=https://example.com

# Яндекс.Метрика (необязательно) — ID счётчика с metrika.yandex.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Данные первого администратора (используются только скриптом seed при первом запуске) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me-strong-password
