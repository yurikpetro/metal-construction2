# Копируйте этот файл в .env на сервере (рядом с docker-compose.yml) и заполните реальными значениями.
# Этот .env читает и docker-compose.yml (переменная DOMAIN), и само приложение внутри контейнера.

# --- База данных (SQLite-файл) ---
# /app/data — том Docker (см. docker-compose.yml), переживает пересборку образа.
DATABASE_URL=file:/app/data/prod.db

# --- Домен для Caddy (автоматический HTTPS через Let's Encrypt) ---
# Без https:// и без www — Caddy сам выпустит сертификат и на www-зеркало
# (см. Caddyfile: www.{$DOMAIN} редиректит на основной адрес).
DOMAIN=krovelnye-ograzhdeniya26.ru

# --- Сессии админки ---
SESSION_SECRET=generate-a-random-32-plus-char-secret

# --- Telegram-уведомления о новых заявках ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email-уведомления (Resend) ---
RESEND_API_KEY=
# Адрес-отправитель. Ящик заводить не нужно, но домен должен быть подтверждён
# в Resend (Domains → Add Domain → DNS-записи DKIM/SPF/DMARC у регистратора).
# Пока домен не подтверждён — ставьте onboarding@resend.dev, но с него письма
# уходят только на почту владельца аккаунта Resend.
RESEND_FROM_EMAIL=noreply@krovelnye-ograzhdeniya26.ru
# Куда падают уведомления о новых заявках
ADMIN_NOTIFICATION_EMAIL=krovelnye-ograzhdeniya26@yandex.ru

# --- Адрес сайта (нужен для canonical, sitemap.xml, robots.txt, og:image) ---
# Обязательно с https:// и без слэша на конце. Держите обе переменные равными.
#
# NEXT_PUBLIC_SITE_URL вшивается в сборку (build arg в docker-compose.yml) —
# именно она даёт правильный canonical на статических страницах.
NEXT_PUBLIC_SITE_URL=https://krovelnye-ograzhdeniya26.ru
# SITE_URL читается сервером в рантайме и страхует robots.txt и sitemap.xml
# от адреса localhost, если образ собрали без build-аргументов.
# ВАЖНО: при смене домена меняйте обе переменные и пересобирайте образ
# (docker compose up -d --build) — иначе на статических страницах
# останется старый canonical.
SITE_URL=https://krovelnye-ograzhdeniya26.ru

# Яндекс.Метрика (необязательно) — ID счётчика с metrika.yandex.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Подтверждение прав на сайт (необязательно, но нужно для индексации) ---
# Google Search Console → «Способ с HTML-тегом» → значение атрибута content
GOOGLE_SITE_VERIFICATION=
# Яндекс.Вебмастер → «Мета-тег» → значение атрибута content
YANDEX_VERIFICATION=

# --- Данные первого администратора (используются только скриптом seed при первом запуске) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me-strong-password
